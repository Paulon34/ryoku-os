# Ryoku Boot Seed — kernel provenance notes (Mission 008)
# No kernel blob is downloaded or committed by this mission.

name = boot-seed-kernel
status = documented_not_fetched
arch = x86_64

# Preferred lab reuse (temporary): kernel inside verified Alpine virt ISO channel.
# Completing Mission 007.1 proved ISO integrity for alpine-virt-3.21.9.
reference_iso_name = alpine-virt-3.21.9-x86_64.iso
reference_iso_sha256 = 1ceafa2ca068faf2925de977815681c182708f3c6cbfbad137f3ffc9324a03b4
reference_iso_url = https://dl-cdn.alpinelinux.org/alpine/v3.21/releases/x86_64/alpine-virt-3.21.9-x86_64.iso
# Typical path inside the ISO (confirm when extracting under authorization):
reference_kernel_member = boot/vmlinuz-virt
license_note = Linux kernel GPLv2; Alpine packaging third-party — NOT Ryoku userland base

# Alternative: pin an official upstream kernel artifact before any T3 fetch.
# upstream_example = https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.12.tar.xz
# upstream_sha256 = (fill when pinned)

local_kernel_relpath = run/ryoku-boot-seed-vmlinuz
local_initrd_relpath = run/ryoku-boot-seed.cpio.gz
boot_markers = RYOKU_BOOT_SEED_READY
