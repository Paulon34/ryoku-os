#!/usr/bin/env bash
# Ryoku video wallpaper runtime (mpvpaper + DMS poster/palette).
# Ported from private ryoku-nixos pkgs/ryoku-video-wallpaper.nix (public logic only;
# no private videos or host paths). Shared by Ryoku Settings, the user unit, and
# change-wallpaper so ordering/fallback lives in one place.
#
# Model:
#   - DMS owns the *static* wallpaper. For video, DMS gets a poster frame once
#     (Matugen palette + lock screen).
#   - mpvpaper renders the video. While it runs, DMS wallpaper screens = [] so
#     only one renderer draws the desktop background.
#   - Selection is runtime state in $XDG_STATE_HOME/ryoku/video-wallpaper.env;
#     ryoku/settings.json records the saved choice (Settings GUI).
#
# mpv options (mpv 0.41 / mpvpaper 1.8+):
#   - hwdec=vaapi: prefer Intel iGPU; avoid auto-safe → nvdec waking NVIDIA.
#   - gpu-hwdec-interop=vaapi: keep NVIDIA render node asleep.
#   - vf=fps=N caps FPS for economy/balanced; quality = source rate.
#   - panscan=1.0 crops to fill (DMS Fill parity).
set -euo pipefail

unit=ryoku-video-wallpaper.service
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/ryoku"
env_file="$state_dir/video-wallpaper.env"
screens_backup="$state_dir/dms-wallpaper-screens.json"
poster_dir="${XDG_CACHE_HOME:-$HOME/.cache}/ryoku/video-posters"
dms_settings="${XDG_CONFIG_HOME:-$HOME/.config}/DankMaterialShell/settings.json"
marker_file="$state_dir/mpvpaper.marker"

log() { printf 'ryoku-video-wallpaper: %s\n' "$*" >&2; }
die() { log "$*"; exit 1; }

usage() {
  cat >&2 <<'EOF'
Usage:
  ryoku-video-wallpaper apply <video> [--loop 0|1] [--audio 0|1]
                              [--profile economy|balanced|quality]
                              [--pause-covered 0|1]
  ryoku-video-wallpaper stop
  ryoku-video-wallpaper poster <video>
  ryoku-video-wallpaper status
Unit internals: check | run | dms-hide | dms-restore | stop-orphans
EOF
  exit 2
}

is_video() {
  case "${1,,}" in
    *.mp4 | *.webm | *.mkv | *.mov) return 0 ;;
    *) return 1 ;;
  esac
}

# Absolute path safe in systemd EnvironmentFile + mpvpaper argv.
is_safe_path() {
  [[ "$1" == /* && "$1" =~ ^[A-Za-z0-9._/+-]+$ && "$1" != *..* ]]
}

is_bool() { [[ "$1" == 0 || "$1" == 1 ]]; }

read_tracked_video() {
  local v=${1:-}
  if [[ -n "$v" ]]; then
    printf '%s\n' "$v"
    return 0
  fi
  if [[ -n "${RYOKU_VIDEO_WALLPAPER:-}" ]]; then
    printf '%s\n' "$RYOKU_VIDEO_WALLPAPER"
    return 0
  fi
  if [[ -f "$env_file" ]]; then
    v=$(awk -F= '/^RYOKU_VIDEO_WALLPAPER=/{gsub(/"/,"",$2); print $2; exit}' "$env_file" || true)
    [[ -n "$v" ]] && { printf '%s\n' "$v"; return 0; }
  fi
  if [[ -f "$marker_file" ]]; then
    head -n1 "$marker_file"
    return 0
  fi
  return 1
}

# Kill leftover mpvpaper for this uid whose cmdline still references the tracked
# video path. Never touches other users. Safe no-op when nothing matches.
stop_orphans() {
  local video uid pid cmdline
  video=$(read_tracked_video "${1:-}" || true)
  uid=$(id -u)
  [[ -n "$video" ]] || { rm -f "$marker_file"; return 0; }
  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    cmdline=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
    if [[ "$cmdline" == *"$video"* ]]; then
      kill -TERM "$pid" 2>/dev/null || true
    fi
  done < <(pgrep -u "$uid" -x mpvpaper || true)
  sleep 0.4
  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    cmdline=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
    if [[ "$cmdline" == *"$video"* ]]; then
      kill -KILL "$pid" 2>/dev/null || true
    fi
  done < <(pgrep -u "$uid" -x mpvpaper || true)
  rm -f "$marker_file"
}

poster_path() {
  local real size mtime key stem
  real=$(readlink -f -- "$1")
  size=$(stat -c %s -- "$real")
  mtime=$(stat -c %Y -- "$real")
  key=$(printf '%s\0%s\0%s' "$real" "$size" "$mtime" | sha256sum | cut -c1-16)
  stem=$(basename -- "$1")
  printf '%s/%s-%s.jpg\n' "$poster_dir" "${stem%.*}" "$key"
}

# One-shot ffmpeg: best of 24 frames starting at min(2s, 15% duration).
cmd_poster() {
  local video=$1 out dur ss tmp
  [[ -r "$video" ]] || die "video not found: $video"
  out=$(poster_path "$video")
  if [[ ! -s "$out" ]]; then
    mkdir -p "$poster_dir"
    dur=$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 -- "$video" || true)
    ss=$(awk -v d="${dur:-0}" 'BEGIN { t = d * 0.15; if (t > 2) t = 2; if (!(t > 0)) t = 0; printf "%.3f", t }')
    tmp="$out.$$.tmp.jpg"
    if ! ffmpeg -nostdin -v error -y -ss "$ss" -i "$video" -map 0:v:0 \
      -vf 'thumbnail=n=24,scale=min(iw\,2560):-2' -frames:v 1 -q:v 3 "$tmp" \
      || [[ ! -s "$tmp" ]]; then
      ffmpeg -nostdin -v error -y -i "$video" -map 0:v:0 \
        -vf 'scale=min(iw\,2560):-2' -frames:v 1 -q:v 3 "$tmp" \
        || { rm -f "$tmp"; die "could not extract a poster frame from $video"; }
    fi
    mv -f "$tmp" "$out"
  fi
  printf '%s\n' "$out"
}

dms_wallpaper_screens() {
  jq -c '.screenPreferences.wallpaper // ["all"]' "$dms_settings"
}

dms_set_wallpaper_screens() {
  local tmp="$dms_settings.ryoku.$$"
  jq --argjson v "$1" '.screenPreferences = ((.screenPreferences // {}) + {wallpaper: $v})' \
    "$dms_settings" >"$tmp"
  mv -f "$tmp" "$dms_settings"
  if command -v dms >/dev/null 2>&1; then
    dms ipc call ryoku refreshSettings >/dev/null 2>&1 || true
  fi
}

cmd_dms_hide() {
  local current
  if [[ -n "${MAINPID:-}" ]] && ! kill -0 "$MAINPID" 2>/dev/null; then
    return 0
  fi
  [[ -f "$dms_settings" ]] || return 0
  current=$(dms_wallpaper_screens)
  [[ "$current" == "[]" ]] && return 0
  mkdir -p "$state_dir"
  printf '%s\n' "$current" >"$screens_backup"
  dms_set_wallpaper_screens '[]'
}

cmd_dms_restore() {
  local saved
  [[ -f "$screens_backup" ]] || return 0
  if [[ -f "$dms_settings" && "$(dms_wallpaper_screens)" == "[]" ]]; then
    saved=$(cat "$screens_backup")
    if ! jq -e 'type == "array" and length > 0' >/dev/null 2>&1 <<<"$saved"; then
      saved='["all"]'
    fi
    dms_set_wallpaper_screens "$saved"
  fi
  rm -f "$screens_backup"
}

cmd_check() {
  local video=${RYOKU_VIDEO_WALLPAPER:-}
  if [[ -z "$video" ]] || ! is_video "$video" || [[ ! -r "$video" ]]; then
    log "video wallpaper unavailable (${video:-unset}); keeping the static wallpaper"
    cmd_dms_restore
    exit 1
  fi
  (cmd_poster "$video" >/dev/null) || true
}

cmd_run() {
  local video=${RYOKU_VIDEO_WALLPAPER:-}
  local profile=${RYOKU_VIDEO_WALLPAPER_PROFILE:-balanced}
  local -a opts=(hwdec=vaapi gpu-hwdec-interop=vaapi panscan=1.0 osd-level=0 msg-level=all=error)
  local -a flags=()

  [[ -n "$video" ]] || die "RYOKU_VIDEO_WALLPAPER is not set"

  if [[ "${RYOKU_VIDEO_WALLPAPER_LOOP:-1}" == 1 ]]; then
    opts+=(loop-file=inf)
  else
    opts+=(loop-file=no keep-open=yes)
  fi

  if [[ "${RYOKU_VIDEO_WALLPAPER_AUDIO:-0}" == 1 ]]; then
    opts+=(aid=auto)
  else
    opts+=(aid=no)
  fi

  case "$profile" in
    economy) opts+=(vf=fps=15 profile=fast) ;;
    balanced) opts+=(vf=fps=30 profile=fast) ;;
    quality) ;;
    *)
      log "unknown profile '$profile', using balanced"
      opts+=(vf=fps=30 profile=fast)
      ;;
  esac

  if [[ "${RYOKU_VIDEO_WALLPAPER_PAUSE_COVERED:-1}" == 1 ]]; then
    # MAX also covers maximized windows, not only fullscreen games.
    # The native compositor heuristic is best-effort, not per-output policy.
    flags+=(--auto-pause --auto-mode MAX)
  fi

  # One mpvpaper instance; ALL outputs (multi-monitor).
  mkdir -p "$state_dir"
  printf '%s\n' "$video" >"$marker_file"
  # Host Mesa EGL integration, as used by Ryoku Settings and DMS on Debian.
  exec nixGLIntel mpvpaper "${flags[@]}" --mpv-options "${opts[*]}" \
    "${RYOKU_VIDEO_WALLPAPER_OUTPUTS:-ALL}" "$video"
}

write_env() {
  local tmp="$env_file.$$"
  mkdir -p "$state_dir"
  {
    printf 'RYOKU_VIDEO_WALLPAPER="%s"\n' "$1"
    printf 'RYOKU_VIDEO_WALLPAPER_LOOP=%s\n' "$2"
    printf 'RYOKU_VIDEO_WALLPAPER_AUDIO=%s\n' "$3"
    printf 'RYOKU_VIDEO_WALLPAPER_PROFILE=%s\n' "$4"
    printf 'RYOKU_VIDEO_WALLPAPER_PAUSE_COVERED=%s\n' "$5"
    printf 'RYOKU_VIDEO_WALLPAPER_OUTPUTS=ALL\n'
  } >"$tmp"
  mv -f "$tmp" "$env_file"
}

cmd_apply() {
  local video="" loop=1 audio=0 profile=balanced pause=1 poster out
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --loop) loop=${2:-}; shift 2 ;;
      --audio) audio=${2:-}; shift 2 ;;
      --profile) profile=${2:-}; shift 2 ;;
      --pause-covered) pause=${2:-}; shift 2 ;;
      -*) usage ;;
      *) [[ -z "$video" ]] || usage; video=$1; shift ;;
    esac
  done

  [[ -n "$video" ]] || usage
  is_safe_path "$video" || die "unsupported video path: $video"
  is_video "$video" || die "unsupported video format: $video"
  [[ -r "$video" ]] || die "video not found: $video"
  if ! is_bool "$loop" || ! is_bool "$audio" || ! is_bool "$pause"; then
    die "--loop/--audio/--pause-covered take 0 or 1"
  fi
  case "$profile" in economy | balanced | quality) ;; *) die "unknown profile: $profile" ;; esac

  poster=$(cmd_poster "$video")

  # Palette + lock screen from the poster (Matugen once via DMS / optional CLI).
  if command -v dms >/dev/null 2>&1; then
    out=$(dms ipc call wallpaper set "$poster" 2>&1) || true
    [[ "$out" == SUCCESS* ]] || log "dms: $out"
  else
    log "dms not found; palette not updated"
  fi
  # Force dark Material You even if DMS matugen follows luminance.
  if command -v matugen >/dev/null 2>&1; then
    matugen image "$poster" --mode dark >&2 \
      || log "matugen failed for poster (non-fatal; see error above)"
  fi

  write_env "$video" "$loop" "$audio" "$profile" "$pause"

  # Stop → orphan sweep → start (avoid restart races / duplicate mpvpaper).
  if systemctl --user is-active --quiet "$unit" 2>/dev/null \
    || systemctl --user is-failed --quiet "$unit" 2>/dev/null; then
    cmd_dms_restore
    systemctl --user stop "$unit" 2>/dev/null || true
    sleep 0.5
  fi
  stop_orphans "$video"
  systemctl --user reset-failed "$unit" 2>/dev/null || true
  systemctl --user start "$unit"
  printf '%s\n' "$poster"
}

cmd_stop() {
  local video
  video=$(read_tracked_video || true)
  cmd_dms_restore
  if systemctl --user is-active --quiet "$unit" 2>/dev/null \
    || systemctl --user is-failed --quiet "$unit" 2>/dev/null; then
    systemctl --user stop "$unit" 2>/dev/null || true
    sleep 0.5
  fi
  rm -f "$env_file"
  stop_orphans "$video"
  systemctl --user reset-failed "$unit" 2>/dev/null || true
}

cmd_stop_orphans() {
  stop_orphans "$@"
}

cmd_status() {
  if systemctl --user is-active --quiet "$unit" 2>/dev/null; then
    echo "active"
  else
    echo "inactive"
  fi
  [[ -f "$env_file" ]] && cat "$env_file"
  return 0
}

[[ $# -ge 1 ]] || usage
sub=$1
shift
case "$sub" in
  apply) cmd_apply "$@" ;;
  stop) cmd_stop ;;
  poster) [[ $# -eq 1 ]] || usage; cmd_poster "$1" ;;
  status) cmd_status ;;
  check) cmd_check ;;
  run) cmd_run ;;
  dms-hide) cmd_dms_hide ;;
  dms-restore) cmd_dms_restore ;;
  stop-orphans) cmd_stop_orphans "$@" ;;
  *) usage ;;
esac
