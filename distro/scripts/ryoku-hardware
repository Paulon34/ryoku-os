#!/usr/bin/env bash
# Read-only hardware detection. --sysroot is a fixture, never a driver install.
# --sensors reports honest host values from /proc, hwmon, thermal_zone and
# power_supply. nvidia-smi is used only when the proprietary stack is already
# present; never installed here and never polled in a tight loop.
set -euo pipefail
root=/; mode=report
while (($#)); do
  case "$1" in
    --sysroot) root=${2:?}; shift 2 ;;
    --packages) mode=packages; shift ;;
    --visual) mode=visual; shift ;;
    --gpu) mode=gpu; shift ;;
    --sensors) mode=sensors; shift ;;
    *) echo "unknown hardware option: $1" >&2; exit 2 ;;
  esac
done
root=${root%/}
readval() { if [[ -r "$1" ]]; then cat "$1"; fi; }
intel=0; amd=0; nvidia=0; virtual=0; network=(); packages=()
for d in "$root"/sys/bus/pci/devices/*; do
  [[ -d "$d" ]] || continue
  vendor=$(readval "$d/vendor"); class=$(readval "$d/class")
  case "$class:$vendor" in
    0x03*:0x8086) intel=1 ;;
    0x03*:0x1002) amd=1 ;;
    0x03*:0x10de) nvidia=1 ;;
    0x03*:0x1af4|0x03*:0x1234|0x03*:0x15ad|0x03*:0x80ee) virtual=1 ;;
    0x02*:0x8086) [[ "$class" != 0x0280* ]] || packages+=(firmware-iwlwifi) ;;
    0x02*:0x10ec) packages+=(firmware-realtek) ;;
    0x02*:0x168c|0x02*:0x17cb) packages+=(firmware-atheros) ;;
    0x02*:0x14c3|0x02*:0x1814) packages+=(firmware-mediatek) ;;
    0x02*:0x14e4) packages+=(firmware-brcm80211) ;;
  esac
done
# USB Bluetooth/Wi-Fi vendor families (heuristic, no out-of-tree driver).
for d in "$root"/sys/bus/usb/devices/*; do
  [[ -r "$d/idVendor" ]] || continue
  case "$(readval "$d/idVendor")" in
    0bda) packages+=(firmware-realtek) ;;
    0e8d) packages+=(firmware-mediatek) ;;
    8087) packages+=(firmware-iwlwifi) ;;
    0cf3) packages+=(firmware-atheros) ;;
  esac
done
cpu=$(awk '/^vendor_id[[:space:]]*:/ {print $3; exit}' "$root/proc/cpuinfo" 2>/dev/null || true)
mem=$(awk '/^MemTotal:/ {print $2; exit}' "$root/proc/meminfo" 2>/dev/null || true)
mem=${mem:-0}
if [[ -z "$root" ]] && command -v systemd-detect-virt >/dev/null; then
  if systemd-detect-virt --quiet --vm; then virtual=1; fi
fi
if (( !virtual )); then
  case "$cpu" in
    GenuineIntel) packages+=(intel-microcode) ;;
    AuthenticAMD) packages+=(amd64-microcode) ;;
  esac
fi
if ((intel)); then packages+=(firmware-intel-graphics intel-media-va-driver); fi
if ((amd)); then packages+=(firmware-amd-graphics mesa-va-drivers); fi
if ((nvidia)); then packages+=(firmware-nvidia-graphics); fi
if (( !virtual )); then packages+=(firmware-sof-signed); fi
gpu=unknown
if ((virtual)); then gpu=virtual
elif ((nvidia && (intel || amd))); then gpu=hybrid-nvidia
elif ((nvidia)); then gpu=nvidia
elif ((intel)); then gpu=intel
elif ((amd)); then gpu=amd
fi
visual=balanced
if ((virtual || (mem > 0 && mem < 6000000))); then visual=lite; fi

report_sensors() {
  echo "=== Ryoku sensors (read-only; missing paths are omitted, never invented) ==="
  if [[ -r "$root/proc/stat" ]]; then
    awk '/^cpu / {
      idle=$5; total=0; for (i=2;i<=NF;i++) total+=$i;
      if (total>0) printf "CPU idle ticks fraction (instant /proc/stat): %.1f%%\n", 100*idle/total;
      else print "CPU: /proc/stat unusable";
      exit
    }' "$root/proc/stat"
  else
    echo "CPU: /proc/stat unavailable"
  fi
  if [[ -r "$root/proc/meminfo" ]]; then
    awk '
      /^MemTotal:/ {t=$2}
      /^MemAvailable:/ {a=$2}
      END {
        if (t>0) printf "RAM: total=%d KiB available=%s KiB (%.0f%% used if Available present)\n",
          t, (a==""?"?":a), (a==""?0:100*(t-a)/t);
        else print "RAM: /proc/meminfo unusable";
      }' "$root/proc/meminfo"
  else
    echo "RAM: /proc/meminfo unavailable"
  fi
  local found_hwmon=0
  for t in "$root"/sys/class/hwmon/hwmon*/temp*_input; do
    [[ -r "$t" ]] || continue
    found_hwmon=1
    local label="" name=""
    [[ -r "${t%_input}_label" ]] && label=$(readval "${t%_input}_label")
    [[ -r "$(dirname "$t")/name" ]] && name=$(readval "$(dirname "$t")/name")
    local milli
    milli=$(readval "$t")
    [[ -n "$milli" ]] || continue
    printf 'hwmon temp: %s%s = %.1f°C (%s)\n' \
      "${name:-hwmon}" "${label:+/$label}" "$(awk -v m="$milli" 'BEGIN{print m/1000}')" "$t"
  done
  ((found_hwmon)) || echo "hwmon: no temp*_input nodes readable"
  local found_thermal=0
  for z in "$root"/sys/class/thermal/thermal_zone*; do
    [[ -d "$z" ]] || continue
    [[ -r "$z/temp" ]] || continue
    found_thermal=1
    local typ="" milli
    [[ -r "$z/type" ]] && typ=$(readval "$z/type")
    milli=$(readval "$z/temp")
    [[ -n "$milli" ]] || continue
    printf 'thermal_zone: %s = %.1f°C (%s)\n' \
      "${typ:-unknown}" "$(awk -v m="$milli" 'BEGIN{print m/1000}')" "$z"
  done
  ((found_thermal)) || echo "thermal_zone: none readable"
  local found_ps=0
  for p in "$root"/sys/class/power_supply/*; do
    [[ -d "$p" ]] || continue
    found_ps=1
    local typ="" st="" cap=""
    [[ -r "$p/type" ]] && typ=$(readval "$p/type")
    [[ -r "$p/status" ]] && st=$(readval "$p/status")
    [[ -r "$p/capacity" ]] && cap=$(readval "$p/capacity")
    printf 'power_supply: %s type=%s status=%s capacity=%s\n' \
      "$(basename "$p")" "${typ:-?}" "${st:-?}" "${cap:-n/a}"
  done
  ((found_ps)) || echo "power_supply: none present"
  if [[ -z "$root" || "$root" == "/" ]] && command -v upower >/dev/null 2>&1; then
    upower -e 2>/dev/null | while read -r dev; do
      [[ -n "$dev" ]] || continue
      printf 'UPower: %s\n' "$dev"
    done || true
  else
    echo "UPower: skipped (sysroot fixture or upower missing)"
  fi

  # Intel iGPU — sysfs only (no intel_gpu_top dependency; never invent %).
  local found_intel_drm=0
  for card in "$root"/sys/class/drm/card[0-9]*; do
    [[ -d "$card/device" ]] || continue
    local vendor=""
    [[ -r "$card/device/vendor" ]] && vendor=$(readval "$card/device/vendor")
    [[ "$vendor" == "0x8086" ]] || continue
    found_intel_drm=1
    local freq="" act=""
    [[ -r "$card/device/gt_cur_freq_mhz" ]] && freq=$(readval "$card/device/gt_cur_freq_mhz")
    [[ -z "$freq" && -r "$card/gt_cur_freq_mhz" ]] && freq=$(readval "$card/gt_cur_freq_mhz")
    [[ -r "$card/device/gt_act_freq_mhz" ]] && act=$(readval "$card/device/gt_act_freq_mhz")
    if [[ -n "$freq" || -n "$act" ]]; then
      printf 'Intel iGPU: %s gt_cur_freq_mhz=%s gt_act_freq_mhz=%s (sysfs; utilization%% not claimed)\n' \
        "$(basename "$card")" "${freq:-n/a}" "${act:-n/a}"
    else
      printf 'Intel iGPU: %s present (freq sysfs unavailable; no fake util%%)\n' "$(basename "$card")"
    fi
  done
  ((found_intel_drm)) || echo "Intel iGPU drm: none with vendor 0x8086"

  # Proprietary NVIDIA only — never wake a hybrid dGPU on a schedule from here.
  if [[ -z "$root" || "$root" == "/" ]] && command -v nvidia-smi >/dev/null 2>&1; then
    echo "nvidia-smi: proprietary stack detected (one-shot query, not continuous):"
    nvidia-smi --query-gpu=name,temperature.gpu,utilization.gpu,memory.used,memory.total,power.draw \
      --format=csv,noheader 2>/dev/null || echo "nvidia-smi: query failed (GPU may be asleep/powered off)"
  elif ((nvidia)); then
    echo "NVIDIA: PCI device present but nvidia-smi unavailable — treat dGPU as firmware/Nouveau/asleep (no fake VRAM/util)"
  else
    echo "nvidia-smi: not present or sysroot fixture (Nouveau/firmware-only — no fake GPU metrics)"
  fi
}

case "$mode" in
  packages) if ((${#packages[@]})); then printf '%s\n' "${packages[@]}" | sort -u; fi ;;
  visual) echo "$visual" ;;
  gpu) echo "$gpu" ;;
  sensors) report_sensors ;;
  report)
    echo "GPU: $gpu (Intel=$intel AMD=$amd NVIDIA=$nvidia virtual=$virtual)"
    echo "CPU: ${cpu:-unknown}; RAM KiB: $mem; visual: $visual"
    echo "Firmware/acceleration candidates: ${packages[*]:-none}"
    if ((nvidia)); then
      echo "NVIDIA: use Debian nvidia-detect and check Secure Boot/kernel headers before proprietary driver activation."
      echo "Nix graphics wrapper remains Mesa; NVIDIA-only/offload rendering requires real-host verification."
    fi
    echo "Tip: bash distro/scripts/ryoku-hardware --sensors  # honest /proc hwmon thermal power_supply"
    ;;
esac
