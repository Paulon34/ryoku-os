#!/usr/bin/env bash
# Run as the desktop user after Full bootstrap. Explicitly authorizes
# official third-party repositories/downloads; never copy API keys or VPN state.
set -euo pipefail
[[ $EUID != 0 ]] || { echo "Run as desktop user (sudo used only for APT)" >&2; exit 1; }
. /etc/os-release
[[ "${ID:-}" == debian && "${VERSION_CODENAME:-}" == trixie && "$(dpkg --print-architecture)" == amd64 ]] || { echo "Requires Debian 13 amd64"; exit 1; }
fail=0
tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT
cursor_install() {
  if command -v cursor >/dev/null; then return 0; fi
  curl -fL --proto '=https' --retry 2 -o "$tmp/cursor.deb" https://api2.cursor.sh/updates/download/golden/linux-x64-deb/cursor/latest || return 1
  [[ "$(dpkg-deb -f "$tmp/cursor.deb" Package)" == cursor &&
     "$(dpkg-deb -f "$tmp/cursor.deb" Architecture)" == amd64 ]] || return 1
  sudo apt-get -s --no-remove install "$tmp/cursor.deb" && sudo apt-get install -y --no-remove "$tmp/cursor.deb"
}
codex_install() {
  mkdir -p "$HOME/.local"
  if [[ -x "$HOME/.local/bin/codex" ]] || command -v codex >/dev/null; then return 0; fi
  npm install --global --prefix "$HOME/.local" @openai/codex &&
    "$HOME/.local/bin/codex" --version
}
tailscale_install() {
  if command -v tailscale >/dev/null; then return 0; fi
  curl -fsSL --proto '=https' -o "$tmp/tailscale.gpg" https://pkgs.tailscale.com/stable/debian/trixie.noarmor.gpg || return 1
  curl -fsSL --proto '=https' -o "$tmp/tailscale.list" https://pkgs.tailscale.com/stable/debian/trixie.tailscale-keyring.list || return 1
  sudo install -m 0644 "$tmp/tailscale.gpg" /usr/share/keyrings/tailscale-archive-keyring.gpg || return 1
  sudo install -m 0644 "$tmp/tailscale.list" /etc/apt/sources.list.d/tailscale.list || return 1
  sudo apt-get update && sudo apt-get -s --no-remove install tailscale &&
    sudo apt-get install -y --no-remove tailscale
}
for app in cursor codex tailscale; do
  if "${app}_install"; then echo "OK: $app installed"; else echo "WARN: $app installation failed" >&2; fail=1; fi
done
echo "Sign in to Cursor and Codex yourself. For VPN, run sudo tailscale up after reviewing DNS and login."
echo "If needed: export PATH=\"$HOME/.local/bin:\$PATH\""
exit "$fail"
