diff --git a/Modules/DankBar/Widgets/RyokuWorkspaces.qml b/Modules/DankBar/Widgets/RyokuWorkspaces.qml
new file mode 100644
index 0000000..8e4940b
--- /dev/null
+++ b/Modules/DankBar/Widgets/RyokuWorkspaces.qml
@@ -0,0 +1,155 @@
+import QtQuick
+import Quickshell
+import Quickshell.Hyprland
+import qs.Common
+import qs.Services
+import qs.Widgets
+
+// Quattro workspaces. Behaviour after Omarchy's omarchy.workspaces bar widget
+// (github.com/omacom/omarchy, branch quattro, MIT), reimplemented for Ryoku's
+// global numbering (Super+1…0): slots 1–5 always, then any other workspace
+// that exists; empty ones dimmed; the one this monitor shows drawn as a filled
+// square in the accent colour. Purely event-driven — no timers.
+Item {
+    id: root
+
+    property var axis: null
+    property string screenName: ""
+    property var parentScreen: null
+    property real widgetHeight: 30
+    property real barThickness: 48
+    property var barConfig: null
+
+    readonly property bool isVertical: axis?.isVertical ?? false
+    readonly property var monitor: parentScreen ? Hyprland.monitorFor(parentScreen) : Hyprland.focusedMonitor
+    readonly property int shownId: monitor?.activeWorkspace?.id ?? -1
+    readonly property real slot: Math.round(Math.max(18, widgetHeight * 0.72))
+    readonly property real fontSize: Theme.barTextSize(barThickness, barConfig?.fontScale, barConfig?.maximizeWidgetText)
+    readonly property string shownGlyph: "\u{f14fb}"
+
+    readonly property var ids: {
+        const list = [1, 2, 3, 4, 5];
+        const values = Hyprland.workspaces.values;
+        for (let i = 0; i < values.length; i++) {
+            const id = values[i].id;
+            if (id > 0 && list.indexOf(id) === -1)
+                list.push(id);
+        }
+        list.sort((a, b) => a - b);
+        return list;
+    }
+
+    function workspaceById(id) {
+        const values = Hyprland.workspaces.values;
+        for (let i = 0; i < values.length; i++) {
+            if (values[i].id === id)
+                return values[i];
+        }
+        return null;
+    }
+
+    function focusWorkspace(id) {
+        Hyprland.dispatch("workspace " + id);
+    }
+
+    property real _wheel: 0
+    function scroll(delta) {
+        _wheel += delta;
+        if (Math.abs(_wheel) < 120)
+            return;
+        const step = _wheel > 0 ? -1 : 1;
+        _wheel = 0;
+        const index = ids.indexOf(shownId);
+        if (index === -1)
+            return;
+        const target = ids[Math.max(0, Math.min(ids.length - 1, index + step))];
+        if (target !== shownId)
+            focusWorkspace(target);
+    }
+
+    // Quickshell credits a switch to the focused monitor; moving or renumbering
+    // a workspace needs a fresh read from Hyprland.
+    Connections {
+        target: Hyprland
+        function onRawEvent(event) {
+            const name = event ? String(event.name) : "";
+            if (name === "moveworkspacev2" || name === "changeworkspaceid") {
+                Hyprland.refreshMonitors();
+                Hyprland.refreshWorkspaces();
+            }
+        }
+    }
+
+    implicitWidth: isVertical ? barThickness : grid.implicitWidth
+    implicitHeight: isVertical ? grid.implicitHeight : barThickness
+    width: implicitWidth
+    height: implicitHeight
+
+    Grid {
+        id: grid
+        anchors.centerIn: parent
+        columns: root.isVertical ? 1 : root.ids.length
+        spacing: 1
+
+        Repeater {
+            model: root.ids
+
+            Item {
+                id: cell
+                required property int modelData
+
+                readonly property var workspace: root.workspaceById(modelData)
+                readonly property bool occupied: workspace !== null && (workspace.toplevels?.values?.length ?? 0) > 0
+                readonly property bool shown: modelData === root.shownId
+                readonly property bool urgent: workspace?.urgent ?? false
+
+                width: root.isVertical ? root.widgetHeight : root.slot
+                height: root.isVertical ? root.slot : root.widgetHeight
+
+                Rectangle {
+                    anchors.fill: parent
+                    anchors.margins: 1
+                    radius: Math.min(6, Theme.cornerRadius)
+                    color: Theme.withAlpha(Theme.surfaceText, hover.containsMouse && !cell.shown ? RyokuVisual.stateHover : 0)
+                }
+
+                StyledText {
+                    id: label
+                    anchors.centerIn: parent
+                    text: cell.shown ? root.shownGlyph : (cell.modelData === 10 ? "0" : String(cell.modelData))
+                    font.family: RyokuVisual.chromeFont
+                    font.pixelSize: cell.shown ? Math.round(root.fontSize * 1.05) : root.fontSize
+                    font.weight: cell.shown ? Font.DemiBold : Font.Normal
+                    color: cell.urgent ? Theme.error : (cell.shown ? Theme.primary : Theme.widgetTextColor)
+                    opacity: cell.shown || cell.occupied || cell.urgent ? 1 : 0.45
+                    scale: hover.pressed ? RyokuVisual.pressScale : 1
+
+                    Behavior on opacity {
+                        NumberAnimation {
+                            duration: Theme.currentAnimationBaseDuration === 0 ? 0 : 140
+                            easing.type: Easing.OutCubic
+                        }
+                    }
+
+                    Behavior on scale {
+                        NumberAnimation {
+                            duration: Theme.currentAnimationBaseDuration === 0 ? 0 : 160
+                            easing.type: Easing.BezierSpline
+                            easing.bezierCurve: RyokuVisual.easeOut
+                        }
+                    }
+                }
+
+                MouseArea {
+                    id: hover
+                    anchors.fill: parent
+                    hoverEnabled: true
+                    cursorShape: Qt.PointingHandCursor
+                    onClicked: if (!cell.shown)
+                        root.focusWorkspace(cell.modelData)
+                    onWheel: wheel => root.scroll(wheel.angleDelta.y)
+                }
+            }
+        }
+    }
+}
