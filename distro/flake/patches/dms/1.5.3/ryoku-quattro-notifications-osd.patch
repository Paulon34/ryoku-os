diff --git a/Widgets/RyokuOsdMeter.qml b/Widgets/RyokuOsdMeter.qml
new file mode 100644
index 0000000..662954e
--- /dev/null
+++ b/Widgets/RyokuOsdMeter.qml
@@ -0,0 +1,76 @@
+import QtQuick
+import qs.Common
+
+// Quattro OSD row, after Omarchy's OSD card: glyph, a flat progress bar
+// (accent on a muted track) and a bold readout as wide as "100%", so the
+// digits never shift the bar. Visual only.
+Item {
+    id: root
+
+    property string iconName: ""
+    property real value: 0
+    property real maximum: 100
+    property bool muted: false
+    property string readout: Math.round(value) + "%"
+
+    readonly property int pad: 16
+    readonly property int gap: 14
+    readonly property int iconSize: 26
+    readonly property int barWidth: 142
+    readonly property int readoutWidth: Math.ceil(widest.advanceWidth)
+
+    implicitWidth: pad * 2 + iconSize + gap + barWidth + gap + readoutWidth
+    implicitHeight: pad * 2 + iconSize
+
+    TextMetrics {
+        id: widest
+        font.family: RyokuVisual.chromeFont
+        font.pixelSize: Theme.fontSizeMedium
+        font.weight: Font.Bold
+        text: "100%"
+    }
+
+    Row {
+        anchors.centerIn: parent
+        spacing: root.gap
+
+        DankIcon {
+            anchors.verticalCenter: parent.verticalCenter
+            name: root.iconName
+            size: root.iconSize
+            color: root.muted ? Theme.surfaceVariantText : Theme.surfaceText
+        }
+
+        Rectangle {
+            anchors.verticalCenter: parent.verticalCenter
+            width: root.barWidth
+            height: 6
+            radius: 1
+            color: Theme.withAlpha(Theme.surfaceText, 0.25)
+
+            Rectangle {
+                height: parent.height
+                radius: parent.radius
+                width: parent.width * Math.max(0, Math.min(1, root.maximum > 0 ? root.value / root.maximum : 0))
+                color: root.muted ? Theme.surfaceVariantText : Theme.primary
+
+                Behavior on width {
+                    NumberAnimation {
+                        duration: Theme.currentAnimationBaseDuration === 0 ? 0 : 140
+                        easing.type: Easing.OutCubic
+                    }
+                }
+            }
+        }
+
+        Text {
+            anchors.verticalCenter: parent.verticalCenter
+            width: root.readoutWidth
+            horizontalAlignment: Text.AlignRight
+            text: root.readout
+            font: widest.font
+            color: Theme.surfaceText
+            renderType: Text.NativeRendering
+        }
+    }
+}
