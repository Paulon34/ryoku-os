+        if (!adapter.enabled)
+            return adapter.state === BluetoothAdapterState.Enabling ? "enabling" : "off";
+        if (pairedRepeater.count > 0 || availableRepeater.count > 0)
+            return "";
+        if (adapter.discovering)
