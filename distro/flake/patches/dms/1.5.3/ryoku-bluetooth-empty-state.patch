+            root.scanStarted = true;
+            root.scanFoundDevices = availableRepeater.count > 0;
+        }
+    }
+
+    function friendlyBluetoothError(raw) {
+        const text = String(raw || "");
+        if (/AuthenticationCanceled|AuthenticationRejected/i.test(text))
+            return I18n.tr("Pairing was canceled on the device.");
+        if (/AuthenticationFailed/i.test(text))
+            return I18n.tr("Authentication failed. Try pairing again.");
+        if (/ConnectionAttemptFailed|page-timeout|br-connection/i.test(text))
+            return I18n.tr("Could not connect. Keep the device close and in pairing mode.");
+        if (/AuthenticationTimeout|timed? ?out/i.test(text))
+            return I18n.tr("The device did not respond in time.");
+        if (/AlreadyExists/i.test(text))
+            return I18n.tr("The device is already paired.");
+        if (/InProgress/i.test(text))
+            return I18n.tr("Another Bluetooth operation is in progress.");
+        if (/NotReady/i.test(text))
+            return I18n.tr("Bluetooth is not ready.");
+        if (/DoesNotExist|UnknownObject/i.test(text))
+            return I18n.tr("Device not found.");
+        const tail = text.split(": ").pop().replace(/^org\.bluez\.Error\./, "").trim();
+        return tail.length > 120 ? tail.slice(0, 117) + "..." : tail;
+    }
+
