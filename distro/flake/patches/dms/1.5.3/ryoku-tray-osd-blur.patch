diff -ruN a/Widgets/DankOSD.qml b/Widgets/DankOSD.qml
--- a/Widgets/DankOSD.qml
+++ b/Widgets/DankOSD.qml
@@ -100,12 +100,16 @@
     WlrLayershell.exclusiveZone: -1
     WlrLayershell.keyboardFocus: WlrKeyboardFocus.None

+    // Blur follows the card's scale × opacity (same as notification popups), so it stays
+    // inside the visible card while it animates and fades out with it on hide instead of
+    // vanishing before the fade starts.
     WindowBlur {
         targetWindow: root
-        blurX: shadowBuffer
-        blurY: shadowBuffer
-        blurWidth: shouldBeVisible ? alignedWidth : 0
-        blurHeight: shouldBeVisible ? alignedHeight : 0
+        readonly property real s: Math.min(1, osdContainer.scale) * Math.max(0, osdContainer.opacity)
+        blurX: shadowBuffer + alignedWidth * (1 - s) * 0.5
+        blurY: shadowBuffer + alignedHeight * (1 - s) * 0.5
+        blurWidth: alignedWidth * s
+        blurHeight: alignedHeight * s
         blurRadius: Theme.cornerRadius
     }
