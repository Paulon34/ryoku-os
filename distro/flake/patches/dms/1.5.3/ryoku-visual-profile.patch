diff --git a/Common/RyokuVisual.qml b/Common/RyokuVisual.qml
new file mode 100644
index 0000000..55a640f
--- /dev/null
+++ b/Common/RyokuVisual.qml
@@ -0,0 +1,197 @@
+pragma Singleton
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import Quickshell.Hyprland
+import Quickshell.Services.UPower
+import qs.Common
+import qs.Services
+
+// Ryoku visual profile — resident, event-driven.
+//
+// Source of truth: ryoku/settings.json (appearance.visualProfile /
+// appearance.visualProfileAuto), watched with inotify via FileView; the path
+// is substituted by Nix at build time. AUTO follows UPower / power-profiles-
+// daemon signals, so it works with Ryoku Settings closed. Video wallpaper is
+// detected from DMS's own state: the Ryoku video unit hides the DMS wallpaper
+// layer (screenPreferences.wallpaper = []) while mpvpaper renders.
+//
+// Motion tokens mirror apps/ryoku-settings RyokuTheme (fast / standard /
+// emphasized / exit). No timers, no polling: everything is a binding or a
+// one-shot hyprctl call when the effective state changes.
+Singleton {
+    id: root
+
+    readonly property string settingsPath: "@RYOKU_SETTINGS_JSON@"
+
+    property string configuredProfile: "balanced"
+    property bool autoEnabled: false
+
+    // ── Power state (UPower / power-profiles-daemon) ─────────────────────
+    readonly property bool powerSaver: typeof PowerProfiles !== "undefined"
+                                       && PowerProfiles.profile === PowerProfile.PowerSaver
+    readonly property bool onBattery: BatteryService.batteryAvailable && !BatteryService.isPluggedIn
+    readonly property bool batteryLow: onBattery && BatteryService.batteryLevel <= 20
+    // AUTO: power-saver or low battery → Economy; on battery, Cinematic → Balanced.
+    readonly property bool autoEconomy: autoEnabled && (powerSaver || batteryLow)
+
+    readonly property string profile: {
+        if (autoEconomy)
+            return "economy";
+        if (autoEnabled && onBattery && configuredProfile === "cinematic")
+            return "balanced";
+        return configuredProfile;
+    }
+    readonly property bool economy: profile === "economy"
+    readonly property bool cinematic: profile === "cinematic"
+
+    readonly property bool videoWallpaperActive: {
+        const prefs = SettingsData.screenPreferences;
+        return !!prefs && Array.isArray(prefs.wallpaper) && prefs.wallpaper.length === 0;
+    }
+
+    // ── Motion tokens ────────────────────────────────────────────────────
+    readonly property int fastDuration: economy ? 90 : 120
+    readonly property int enterDuration: economy ? 120 : (cinematic ? 260 : 200)
+    readonly property int emphasizedDuration: economy ? 160 : (cinematic ? 320 : 280)
+    readonly property int exitDuration: economy ? 100 : (cinematic ? 150 : 140)
+
+    // Material 3 curves — no overshoot anywhere (no bounce).
+    readonly property list<real> enterCurve: economy ? [0, 0, 0, 1, 1, 1] : [0.05, 0.7, 0.1, 1, 1, 1]
+    readonly property list<real> exitCurve: [0.3, 0, 0.8, 0.15, 1, 1]
+
+    // Depth: Economy = fade only; Balanced = fade + scale; Cinematic = + X tilt.
+    readonly property real scaleCollapsed: economy ? 1.0 : (cinematic ? 0.94 : 0.96)
+    readonly property real animOffset: economy ? 0 : (cinematic ? 16 : 10)
+    readonly property real tiltDegrees: cinematic ? 4 : 0
+    readonly property real osdScaleCollapsed: economy ? 1.0 : (cinematic ? 0.9 : 0.94)
+
+    // Elevation and effects.
+    readonly property bool shadowsEnabled: !economy
+    readonly property int popoutElevation: cinematic ? 3 : 2
+    readonly property int modalElevation: cinematic ? 4 : 3
+    readonly property bool blurAllowed: !economy
+
+    // Material state layers (hover / pressed / focus).
+    readonly property real stateHover: 0.06
+    readonly property real statePressed: 0.10
+    readonly property real stateFocus: 0.10
+
+    // Projected rect of a card tilted `degrees` about its X axis, as a fraction
+    // of its untilted size. Qt's Rotation projects with distanceToPlane 1024:
+    // the far edge shrinks by d / (d + h/2·sinθ). Blur regions use this inner
+    // rect so they never extend past the tilted card's corners.
+    function tiltInset(height, degrees) {
+        if (!degrees)
+            return 1;
+        const d = 1024;
+        const rad = Math.abs(degrees) * Math.PI / 180;
+        return d / (d + height * 0.5 * Math.sin(rad)) * Math.cos(rad);
+    }
+
+    // ── ryoku/settings.json ──────────────────────────────────────────────
+    function _parse(text) {
+        let profile = "balanced";
+        let auto = false;
+        try {
+            const appearance = (JSON.parse(text) || {}).appearance || {};
+            if (["economy", "balanced", "cinematic"].indexOf(appearance.visualProfile) >= 0)
+                profile = appearance.visualProfile;
+            auto = appearance.visualProfileAuto === true;
+        } catch (e) {
+            console.warn("RyokuVisual: unreadable", settingsPath, e);
+        }
+        configuredProfile = profile;
+        autoEnabled = auto;
+    }
+
+    FileView {
+        id: settingsFile
+        path: root.settingsPath.startsWith("@") ? "" : root.settingsPath
+        watchChanges: true
+        printErrors: false
+        onFileChanged: reload()
+        onLoaded: root._parse(text())
+        onLoadFailed: root._parse("{}")
+    }
+
+    // ── Hyprland projection (blur / shadows) ─────────────────────────────
+    // Balanced on a static wallpaper equals home/hyprland.nix. Blur over a video
+    // wallpaper is re-rendered every video frame, so it is capped one level lower.
+    readonly property string hyprBatch: {
+        if (economy)
+            return "keyword decoration:blur:enabled false; keyword decoration:shadow:enabled false";
+        let blur;
+        if (cinematic)
+            blur = videoWallpaperActive ? [6, 2, 0.17] : [8, 3, 0.2];
+        else
+            blur = videoWallpaperActive ? [5, 1, 0.17] : [6, 2, 0.17];
+        const shadowRange = cinematic ? 22 : 14;
+        return "keyword decoration:blur:enabled true; keyword decoration:blur:size " + blur[0]
+            + "; keyword decoration:blur:passes " + blur[1]
+            + "; keyword decoration:blur:vibrancy " + blur[2]
+            + "; keyword decoration:shadow:enabled true; keyword decoration:shadow:range " + shadowRange;
+    }
+
+    property string _appliedBatch: ""
+
+    function applyHyprland(force) {
+        if (!CompositorService.isHyprland)
+            return;
+        if (!force && hyprBatch === _appliedBatch)
+            return;
+        if (hyprProc.running) {
+            Qt.callLater(root.applyHyprland, force);
+            return;
+        }
+        _appliedBatch = hyprBatch;
+        hyprProc.command = ["hyprctl", "--batch", hyprBatch];
+        hyprProc.running = true;
+    }
+
+    onHyprBatchChanged: Qt.callLater(root.applyHyprland, false)
+    Component.onCompleted: Qt.callLater(root.applyHyprland, true)
+
+    Process {
+        id: hyprProc
+        stderr: StdioCollector {
+            onStreamFinished: if (text.trim().length > 0)
+                console.warn("RyokuVisual: hyprctl:", text.trim())
+        }
+    }
+
+    // `dms ipc call ryoku refreshSettings` — used by ryoku-video-wallpaper after
+    // it rewrites screenPreferences; `dms ipc call ryoku status` for diagnostics.
+    IpcHandler {
+        target: "ryoku"
+
+        function refreshSettings(): string {
+            SettingsData.ryokuReloadFromDisk();
+            settingsFile.reload();
+            return "ok";
+        }
+
+        function status(): string {
+            return JSON.stringify({
+                "profile": root.profile,
+                "configured": root.configuredProfile,
+                "auto": root.autoEnabled,
+                "powerSaver": root.powerSaver,
+                "onBattery": root.onBattery,
+                "videoWallpaper": root.videoWallpaperActive,
+                "hyprland": root._appliedBatch
+            });
+        }
+    }
+
+    // A config reload resets runtime keywords to home/hyprland.nix (Balanced).
+    Connections {
+        target: CompositorService.isHyprland ? Hyprland : null
+        function onRawEvent(event) {
+            if (event.name === "configreloaded")
+                root.applyHyprland(true);
+        }
+    }
+}
