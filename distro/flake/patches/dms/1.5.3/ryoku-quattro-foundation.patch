diff --git a/Widgets/RyokuFrame.qml b/Widgets/RyokuFrame.qml
new file mode 100644
index 0000000..e7fede8
--- /dev/null
+++ b/Widgets/RyokuFrame.qml
@@ -0,0 +1,59 @@
+import QtQuick
+import QtQuick.Shapes
+import qs.Common
+
+// Quattro surface frame: a ring in the Hyprland active-border gradient, drawn
+// over a card's own fill. Same tones as home/matugen/templates/
+// ryoku-hyprland-quattro.conf (surface_tint → tertiary_fixed_dim at 45°), so
+// shell surfaces and windows share one border. A static Shape — repainted
+// only when the card's size or palette changes.
+Shape {
+    id: root
+
+    property real frameWidth: RyokuVisual.frameWidth
+    property real radius: Theme.cornerRadius
+    property color startColor: Theme.currentThemeData.surfaceTint ? Theme.surfaceTint : Theme.primary
+    property color endColor: Theme.getMatugenColor("tertiary_fixed_dim", Theme.tertiary)
+    property real alpha: 0.93
+
+    readonly property real _inner: Math.max(0, radius - frameWidth)
+
+    visible: width > frameWidth * 2 && height > frameWidth * 2
+    preferredRendererType: Shape.CurveRenderer
+
+    ShapePath {
+        strokeWidth: -1
+        strokeColor: "transparent"
+        fillRule: ShapePath.OddEvenFill
+        fillGradient: LinearGradient {
+            x1: 0
+            y1: root.height
+            x2: root.width
+            y2: 0
+            GradientStop {
+                position: 0
+                color: Theme.withAlpha(root.startColor, root.alpha)
+            }
+            GradientStop {
+                position: 1
+                color: Theme.withAlpha(root.endColor, root.alpha)
+            }
+        }
+
+        PathRectangle {
+            x: 0
+            y: 0
+            width: root.width
+            height: root.height
+            radius: root.radius
+        }
+
+        PathRectangle {
+            x: root.frameWidth
+            y: root.frameWidth
+            width: root.width - root.frameWidth * 2
+            height: root.height - root.frameWidth * 2
+            radius: root._inner
+        }
+    }
+}
