+    // Ryoku islands: pad the section when chrome is transparent (noBackground).
+    readonly property real islandPad: {
+        if (!noBackground)
+            return 0;
+        return Math.max(4, (barConfig?.innerPadding ?? 4));
+    }
+
+    readonly property color islandColor: {
+        const rawTransparency = (barConfig && barConfig.widgetTransparency !== undefined) ? barConfig.widgetTransparency : 1.0;
+        const baseColor = Theme.widgetBaseBackgroundColor;
+        if (Theme.widgetBackgroundHasAlpha)
+            return Theme.blendAlpha(baseColor, rawTransparency);
+        return Theme.withAlpha(baseColor, rawTransparency);
+    }
+
+    implicitWidth: {
+        const contentW = layoutLoader.item ? layoutLoader.item.implicitWidth : 0;
+        return contentW + islandPad * 2;
+    }
+    implicitHeight: {
+        const contentH = layoutLoader.item ? layoutLoader.item.implicitHeight : 0;
+        if (!noBackground)
+            return contentH;
+        return Math.max(widgetThickness, contentH) + islandPad * 2;
+    }
+
+    // Section capsule — only in floating-islands mode (noBackground).
+    Rectangle {
+        id: islandBg
+        z: -1
+        visible: root.noBackground && (layoutLoader.item ? layoutLoader.item.implicitWidth > 0 : false)
+        anchors.centerIn: parent
+        width: {
+            const contentW = layoutLoader.item ? layoutLoader.item.implicitWidth : 0;
+            return contentW + root.islandPad * 2;
+        }
+        height: {
+            if (root.isVertical) {
+                const contentH = layoutLoader.item ? layoutLoader.item.implicitHeight : 0;
+                return contentH + root.islandPad * 2;
+            }
+            return root.widgetThickness;
+        }
+        radius: Theme.cornerRadius
+        color: root.islandColor
+        border.width: 0
+    }

     Loader {
         id: layoutLoader
-        anchors.fill: parent
+        anchors.centerIn: parent
+        width: item ? item.implicitWidth : 0
+        height: item ? item.implicitHeight : 0
         sourceComponent: root.isVertical ? columnComp : rowComp
     }

