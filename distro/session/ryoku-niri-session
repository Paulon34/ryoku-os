#!/usr/bin/env bash
# Ryoku Niri session wrapper — Exec= target for the GDM .desktop file.
# Starts a Niri session from the Home Manager / Nix profile when available,
# falling back to PATH. Does not touch bootloaders or partitions.
set -euo pipefail

export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-niri:Ryoku}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-niri}"

# Wayland/Ozone/Qt hints that Home Manager sessionVariables would set on a
# login shell — GDM does not source ~/.profile for this Exec path.
export NIXOS_OZONE_WL="${NIXOS_OZONE_WL:-1}"
export MOZ_ENABLE_WAYLAND="${MOZ_ENABLE_WAYLAND:-1}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"

# Never invent WAYLAND_DISPLAY / XDG_RUNTIME_DIR. pam_systemd + Niri own them.
# Hardcoding wayland-1 or /run/user/1000 breaks multi-seat and non-uid-1000 users.
if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
  echo "ryoku-niri-session: XDG_RUNTIME_DIR unset (pam_systemd / logind required)" >&2
  exit 1
fi
if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
  echo "ryoku-niri-session: noting pre-set WAYLAND_DISPLAY=${WAYLAND_DISPLAY}" >&2
fi

# On Debian (non-NixOS), Nix-built Niri must load the matching Mesa GBM/DRI
# libraries. The Home Manager nixGLIntel package sets GBM_BACKENDS_PATH and
# LIBGL_DRIVERS_PATH; calling Niri directly can look for /run/opengl-driver,
# a NixOS-only location, and leave a blank display on Proxmox.
HM_BIN="${HOME}/.local/state/nix/profiles/home-manager/home-path/bin"
NIX_BIN="${HOME}/.nix-profile/bin"
LOCAL_BIN="${HOME}/.local/bin"

# GDM does not source Home Manager's session PATH. Prepend HM/Nix bins so
# Niri spawn-at-startup and keybind helpers resolve dms/qs/matugen/fuzzel.
export PATH="${LOCAL_BIN}:${HM_BIN}:${NIX_BIN}:${PATH}"

HM_NIRI="${HM_BIN}/niri"
NIX_NIRI="${NIX_BIN}/niri"
HM_NIXGL="${HM_BIN}/nixGLIntel"
NIX_NIXGL="${NIX_BIN}/nixGLIntel"

if [[ -x "$HM_NIRI" ]]; then
  if [[ -x "$HM_NIXGL" ]]; then
    exec "$HM_NIXGL" "$HM_NIRI" --session
  elif [[ -x "$NIX_NIXGL" ]]; then
    exec "$NIX_NIXGL" "$HM_NIRI" --session
  fi
  echo "ryoku-niri-session: Mesa wrapper unavailable; starting unwrapped Niri" >&2
  exec "$HM_NIRI" --session
elif [[ -x "$NIX_NIRI" ]]; then
  if [[ -x "$NIX_NIXGL" ]]; then
    exec "$NIX_NIXGL" "$NIX_NIRI" --session
  fi
  echo "ryoku-niri-session: Mesa wrapper unavailable; starting unwrapped Niri" >&2
  exec "$NIX_NIRI" --session
elif command -v niri >/dev/null 2>&1; then
  exec niri --session
else
  echo "ryoku-niri-session: niri not found (install via Home Manager flake first)" >&2
  exit 1
fi
