#!/usr/bin/env bash
# Ryoku Niri session wrapper — sourced by the display manager (.desktop Exec).
# Starts a Niri session from the Home Manager / Nix profile when available,
# falling back to PATH. Does not touch bootloaders or partitions.
set -euo pipefail

export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-niri:Ryoku}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-niri}"

# Prefer Home Manager profile, then Nix profile, then system PATH.
HM_NIRI="${HOME}/.local/state/nix/profiles/home-manager/home-path/bin/niri"
NIX_NIRI="${HOME}/.nix-profile/bin/niri"

if [[ -x "$HM_NIRI" ]]; then
  exec "$HM_NIRI" --session
elif [[ -x "$NIX_NIRI" ]]; then
  exec "$NIX_NIRI" --session
elif command -v niri >/dev/null 2>&1; then
  exec niri --session
else
  echo "ryoku-niri-session: niri not found (install via Home Manager flake first)" >&2
  exit 1
fi
