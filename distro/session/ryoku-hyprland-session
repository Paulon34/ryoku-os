#!/usr/bin/env bash
# Ryoku Hyprland session wrapper — Exec= target for the GDM .desktop file.
# Prefers APT Hyprland (trixie-backports ~0.55.x) with host Mesa. Does not
# start Niri. Does not touch bootloaders or partitions.
set -euo pipefail

export XDG_CURRENT_DESKTOP="Hyprland"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-Hyprland}"

export NIXOS_OZONE_WL="${NIXOS_OZONE_WL:-1}"
export MOZ_ENABLE_WAYLAND="${MOZ_ENABLE_WAYLAND:-1}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"

if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
  echo "ryoku-hyprland-session: XDG_RUNTIME_DIR unset (pam_systemd / logind required)" >&2
  exit 1
fi

HM_BIN="${HOME}/.local/state/nix/profiles/home-manager/home-path/bin"
NIX_BIN="${HOME}/.nix-profile/bin"
LOCAL_BIN="${HOME}/.local/bin"

# GDM does not source Home Manager's session PATH. Prepend HM/Nix bins so
# exec-once and binds resolve dms/qs/matugen/helpers.
export PATH="${LOCAL_BIN}:${HM_BIN}:${NIX_BIN}:${PATH}"

# GDM does not source Home Manager's XDG_DATA_DIRS either. Without these
# profile share dirs, DMS cannot discover org.ryoku.Settings.desktop (or
# other Nix-installed applications) even when their executables are on PATH.
# Preserve system and Flatpak directories inherited from GDM when present, and
# always include the user applications dir (xdg.desktopEntries) + Flatpak
# exports so launcher indexing sees Ryoku Settings after HM switch.
HM_SHARE="${HM_BIN%/bin}/share"
NIX_SHARE="${NIX_BIN%/bin}/share"
USER_SHARE="${HOME}/.local/share"
FLATPAK_USER="${HOME}/.local/share/flatpak/exports/share"
FLATPAK_SYSTEM="/var/lib/flatpak/exports/share"
export XDG_DATA_DIRS="${HM_SHARE}:${NIX_SHARE}:${USER_SHARE}:${FLATPAK_USER}:${FLATPAK_SYSTEM}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Pointer + dark toolkit prefs: GDM does not source HM sessionVariables.
# Hyprland also sets these via env=; export early so portal helpers and the
# first exec-once children (DMS, Thunar keybind) inherit a dark stack.
# GTK_THEME complements (does not replace) dconf prefer-dark for GTK4/libadwaita.
export XCURSOR_THEME="${XCURSOR_THEME:-Bibata-Modern-Ice}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"
export GTK_THEME="${GTK_THEME:-Adwaita:dark}"
export QT_STYLE_OVERRIDE="${QT_STYLE_OVERRIDE:-adwaita-dark}"
export XDG_ICON_THEME="${XDG_ICON_THEME:-Papirus-Dark}"

# Push the same vars into systemd --user / D-Bus activation (Thunar via
# gio/dbus, Flatpak portals). Best-effort; never abort the session.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd \
    GTK_THEME QT_STYLE_OVERRIDE XCURSOR_THEME XCURSOR_SIZE XDG_ICON_THEME \
    XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP \
    NIXOS_OZONE_WL MOZ_ENABLE_WAYLAND QT_QPA_PLATFORM \
    PATH XDG_DATA_DIRS 2>/dev/null || true
fi

# Hyprland >=0.53 recommends start-hyprland (safe mode/crash recovery).
# Prefer the Debian system wrapper; keep fallbacks for older installations.
if [[ -x /usr/bin/start-hyprland ]]; then
  exec /usr/bin/start-hyprland
elif command -v start-hyprland >/dev/null 2>&1; then
  exec start-hyprland
elif command -v Hyprland >/dev/null 2>&1; then
  echo "ryoku-hyprland-session: start-hyprland unavailable, using legacy Hyprland" >&2
  exec Hyprland
elif [[ -x "${HM_BIN}/Hyprland" ]]; then
  exec "${HM_BIN}/Hyprland"
elif [[ -x "${NIX_BIN}/Hyprland" ]]; then
  exec "${NIX_BIN}/Hyprland"
else
  echo "ryoku-hyprland-session: Hyprland not found (install APT hyprland from trixie-backports)" >&2
  exit 1
fi
